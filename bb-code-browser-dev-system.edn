;; Code Browser Development Environment
;;
;; Start with:
;;   bb server --http --config bb-code-browser-dev-system.edn --nickname code-browser-dev
;;
;; Then:
;;   1. Open browser: http://localhost:8091 (code browser page)
;;   2. List connections: bb nrepl list --mcp code-browser-dev
;;   3. Load UI: bb nrepl eval "(require '[code-browser.core :as cb])" --connection browser-1 --mcp code-browser-dev
;;
;; Modules:
;;   - local-eval: Server-side eval
;;   - mcp-nrepl: Browser introspection
;;   - mcp-http: HTTP MCP transport
;;   - clojure-lsp: Static analysis (always loaded)
;;   - sente-browser: Scittle nREPL + bootstrap page
;;   - nrepl-proxy-server: rebel-readline support
;;   - nrepl-server: bb eval target

{:modules ["mcp-local-eval"
           "mcp-nrepl"
           "nrepl-server"
           "http-core"          ;; Required by mcp-http
           "mcp-http"
           "clojure-lsp"
           "telemetry-db"       ;; Required by sente-browser
           "directory-browser"  ;; Phase 1.5E.16: Required by sente-browser
           "sente-browser"
           "nrepl-proxy-server"]

 :config {"nrepl-server" {:port 7888
                               :host "localhost"}

          "mcp-http" {:port 3000
                      :host "127.0.0.1"}

          "clojure-lsp" {:project-root "."
                         :auto-start true}

          "sente-browser" {:enabled true
                           :ws-port 8090
                           :bootstrap-port 8091
                           :host "127.0.0.1"
                           ;; Path to sente-lite bundle
                           :bundle-path "/Users/franksiebenlist/Development/sente_lite/dist/sente-lite-nrepl.cljs"
                           ;; Code browser mode - enables enhanced bootstrap
                           :code-browser true}

          "nrepl-proxy-server" {:enabled true
                                :port 1667
                                :host "127.0.0.1"
                                :write-port-file? true
                                :port-file ".nrepl-proxy-port"}}}
