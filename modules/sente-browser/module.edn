{:name "sente-browser"
 :version "0.1.0"
 :description "Browser nREPL via sente-lite WebSocket - enables Claude to eval in browser Scittle"

 ;; Depends on mcp-nrepl module for connection/message state
 ;; Phase 1.5E.16: directory-browser for local filesystem navigation
 ;; telemetry-db for browser log ingestion
 :requires ["mcp-nrepl" "directory-browser" "telemetry-db"]

 ;; Entry point
 :entry "sente-browser.core/module"

 ;; Default configuration
 :defaults {:enabled false
            :ws-port 0          ; Ephemeral port by default
            :bootstrap-port 0   ; Ephemeral port by default
            :host "127.0.0.1"}  ; Security: localhost only by default

 ;; Test runner
 :test-runner "test/run_tests.clj"}
