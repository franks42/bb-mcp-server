;; Code Browser v2 development/test configuration
;;
;; Usage:
;;   bb server:start-wait --nickname cb-v2-test --config system-cb-v2-test.edn
;;   open http://localhost:8091
;;   Click "Load Code Browser" button
;;
;; Or use the single script:
;;   bb dev:cb-v2

{:modules-dir "modules"

 ;; Module load order matters: datalevin-pod must load before code-browser-v2
 ;; so the pod is available when code-browser-v2 calls init! during startup.
 :modules ["telemetry-db" "mcp-local-eval" "mcp-nrepl" "directory-browser" "datalevin-pod" "atom-sync"
           "sente-browser" "code-browser-v2" "nrepl-proxy-server" "nrepl-server"]

 :config {"telemetry-db" {:max-entries 10000
                         :min-level :debug
                         :exclude-ns #{"sente-lite."}}
          "sente-browser" {:enabled true :ws-port 8090 :bootstrap-port 8091 :code-browser true
                           :projects ["/Users/franksiebenlist/Development/bb-mcp-server"]}
          "datalevin-pod" {:db-path "/tmp/code-browser-v2-test-db"}
          "nrepl-proxy-server" {:enabled true :port 1667 :write-port-file? true}
          "nrepl-server" {:port 7888 :host "localhost"}
          ;; code-browser-v2 auto-initializes during module start:
          ;; creates Datalevin DB, scans sources, enables browser sync.
          ;; Delete /tmp/cb-v2-test before restart if you need fresh data.
          ;; IMPORTANT: nREPL source points to EXTERNAL target (port 9876),
          ;; not self (port 7888). Self-introspection causes pod deadlocks.
          ;; Start target first: bb --nrepl-server 9876 (or use bb dev:cb-v2)
          "code-browser-v2" {:enabled true
                             :db-path "/tmp/cb-v2-test"
                             :sources [{:type :dir :path "."}
                                      {:type :dir :path "../hasch"}
                                      {:type :nrepl :host "localhost" :port 9876}]}}}
