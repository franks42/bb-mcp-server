;; Test configuration for code-browser-v2 manual testing
;;
;; Start with: bb server --http --port 3000 --config system-cb-v2-test.edn
;; Then connect nREPL: bb rebel-nrepl-client 1667
;; Initialize v2: (require '[code-browser.core :as cb-v2])
;;                (cb-v2/init! {:db-path "/tmp/cb-v2-test" :sources [{:type :dir :path "."}]})

{:modules-dir "modules"

 ;; Modules for code-browser-v2 testing (with dependencies)
 ;; nrepl, directory-browser -> sente-browser
 ;; datalevin-pod, atom-sync -> code-browser-v2
 ;; nrepl-proxy-server -> server-side nREPL for initialization
 :modules ["mcp-local-eval" "nrepl" "directory-browser" "datalevin-pod" "atom-sync"
           "sente-browser" "code-browser-v2" "nrepl-proxy-server"]

 :config {"sente-browser" {:enabled true :ws-port 8090 :bootstrap-port 8091 :code-browser true
                           :projects ["/Users/franksiebenlist/Development/bb-mcp-server"]}
          "datalevin-pod" {:db-path "/tmp/code-browser-v2-test-db"}
          "nrepl-proxy-server" {:enabled true :port 1667 :write-port-file? true}
          "code-browser-v2" {:enabled true}}}
