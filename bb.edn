{:deps {org.babashka/http-client {:mvn/version "0.4.23"}
        http-kit/http-kit {:mvn/version "2.8.1"}
        cheshire/cheshire {:mvn/version "6.1.0"}
        metosin/malli {:mvn/version "0.20.0"}
        com.taoensso/trove {:mvn/version "1.1.0"}
        com.taoensso/timbre {:mvn/version "6.8.0"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        ;; sente-lite for browser WebSocket/nREPL support (SNAPSHOT - still evolving)
        io.github.franks42/sente-lite {:mvn/version "0.4.2-SNAPSHOT"}
        ;; Portable UUIDv7 (RFC 9562) - temporally sortable IDs for server + browser
        com.github.franks42/uuidv7 {:mvn/version "0.5.0"}}

 ;; Core paths only - module paths are discovered dynamically by bootstrap.clj
 ;; Call (bb-mcp-server.bootstrap/ensure-module-paths!) before requiring modules
 :paths ["src" "scripts" "test" "../clj-statecharts-bb-scittle/src"]

 :tasks
 {;; ==========================================================================
  ;; Development Tasks
  ;; ==========================================================================

  lint {:doc "Lint code with clj-kondo"
        :task (shell "clj-kondo" "--lint" "src" "scripts" "server.clj")}

  format {:doc "Format code with cljfmt"
          :task (shell "cljfmt" "fix" "src")}

  fix-parens {:doc "Fix unbalanced parens in file with parmezan (usage: bb fix-parens <file>)"
              :requires ([babashka.process :as p])
              :task (let [file (first *command-line-args*)]
                      (when-not file
                        (println "Usage: bb fix-parens <file>")
                        (System/exit 1))
                      (let [{:keys [exit]} (p/shell {:continue true} "parmezan" "--file" file "--write")]
                        (case exit
                          0 (println "✓ No changes needed -" file)
                          1 (println "✓ Fixed parens in" file)
                          (do (println "✗ Failed to fix" file)
                              (System/exit 1)))))}

  lint-fix {:doc "Lint file(s), auto-fix paren errors if found, re-lint (usage: bb lint-fix <file>...)"
            :task (apply shell "bb" "scripts/lint_fix.clj" *command-line-args*)}

  check {:doc "Run all checks (lint + format)"
         :task (do (run 'lint) (run 'format))}

  ;; ==========================================================================
  ;; Server Tasks
  ;; ==========================================================================

  server {:doc "Run MCP server [--stdio] [--http [port]] [--help]"
          :task (do
                  ;; Bootstrap: discover and add all module paths to classpath
                  ((requiring-resolve 'bb-mcp-server.bootstrap/ensure-module-paths!))
                  ;; Load external modules from BB_MCP_EXTERNAL_MODULES env var
                  ((requiring-resolve 'bb-mcp-server.bootstrap/add-externals-from-env!))
                  (apply (requiring-resolve 'bb-mcp-server.main/-main) *command-line-args*))}

  bootstrap-server {
    :doc "Start the MCP server with minimal bootstrap configuration"
    :task (do
            ;; Bootstrap: discover and add all module paths to classpath
            ((requiring-resolve 'bb-mcp-server.bootstrap/ensure-module-paths!))
            ;; Load external modules from BB_MCP_EXTERNAL_MODULES env var
            ((requiring-resolve 'bb-mcp-server.bootstrap/add-externals-from-env!))
            (apply (requiring-resolve 'bb-mcp-server.main/-main) ["--config" "bb-bootstrap-system.edn" "--http"]))
  }

  ;; Legacy aliases (deprecated - use 'bb server' with flags instead)
  server:stdio {:doc "[DEPRECATED] Use: bb server --stdio"
                :task (apply (requiring-resolve 'bb-mcp-server.main/-main) ["--stdio"])}

  server:http {:doc "[DEPRECATED] Use: bb server --http [port]"
               :task (apply (requiring-resolve 'bb-mcp-server.main/-main)
                            (cons "--http" *command-line-args*))}

  server:streamable {:doc "[DEPRECATED] Use: bb server --http [port]"
                     :task (apply (requiring-resolve 'bb-mcp-server.main/-main)
                                  (cons "--http" *command-line-args*))}

  server:stop {:doc "Stop MCP server by port or nickname"
               :task (apply shell "bb" "scripts/stop_server.clj" *command-line-args*)}

  server:list {:doc "List running MCP servers"
               :task (shell "bb" "scripts/stop_server.clj" "--list")}

  server:start-wait {:doc "Start server and wait for health [--nickname NAME] [--config PATH] [--port PORT]"
                     :task (apply shell "bb" "scripts/start_wait_server.clj" *command-line-args*)}

  server:ports {:doc "Show ports for a running server [nickname] [--all]"
                :task (apply shell "bb" "scripts/list_ports.clj" *command-line-args*)}

  server:restart {:doc "Restart a server (stop + start) [nickname] [--config PATH]"
                  :task (apply shell "bb" "scripts/restart_server.clj" *command-line-args*)}

  ;; ==========================================================================
  ;; Datalevin Pod Management
  ;; ==========================================================================

  datalevin:status {:doc "Show running Datalevin pod processes and lock files"
                    :task (shell "bb" "scripts/datalevin_manager.clj" "status")}

  datalevin:stop {:doc "Stop all Datalevin pod processes"
                  :task (shell "bb" "scripts/datalevin_manager.clj" "stop")}

  datalevin:cleanup {:doc "Stop pods and remove lock files"
                     :task (shell "bb" "scripts/datalevin_manager.clj" "cleanup")}

  ;; ==========================================================================
  ;; HTTP Test Tasks
  ;; ==========================================================================

  http:test {:doc "Run all HTTP tests"
             :task (shell "bb" "scripts/http_test.clj" "all")}

  http:health {:doc "Check HTTP server health"
               :task (shell "bb" "scripts/http_test.clj" "health")}

  http:init {:doc "Test MCP initialize"
             :task (shell "bb" "scripts/http_test.clj" "init")}

  http:tools {:doc "List MCP tools"
              :task (shell "bb" "scripts/http_test.clj" "tools")}

  http:hello {:doc "Test hello tool [name]"
              :task (apply shell "bb" "scripts/http_test.clj" "hello" *command-line-args*)}

  http:add {:doc "Test add tool [a] [b]"
            :task (apply shell "bb" "scripts/http_test.clj" "add" *command-line-args*)}

  http:concat {:doc "Test concat tool [strings...]"
               :task (apply shell "bb" "scripts/http_test.clj" "concat" *command-line-args*)}

  http:call {:doc "Call any tool: http:call <tool> <json-args>"
             :task (apply shell "bb" "scripts/http_test.clj" "call" *command-line-args*)}

  ;; ==========================================================================
  ;; Module Test Tasks
  ;; ==========================================================================

  ;; Helper to bootstrap module paths before running module code
  -bootstrap {:task ((requiring-resolve 'bb-mcp-server.bootstrap/ensure-module-paths!))}

  test:nrepl {:doc "Run mcp-nrepl module unit tests"
              :depends [-bootstrap]
              :task (load-file "modules/mcp-nrepl/test/run_tests.clj")}

  test:http-core {:doc "Run http-core module tests"
                  :depends [-bootstrap]
                  :task (load-file "modules/http-core/test/run_tests.clj")}

  test:mcp-http {:doc "Run mcp-http module tests"
                 :depends [-bootstrap]
                 :task (load-file "modules/mcp-http/test/run_tests.clj")}

  test:mcp-stdio {:doc "Run mcp-stdio module tests"
                  :depends [-bootstrap]
                  :task (load-file "modules/mcp-stdio/test/run_tests.clj")}

  test:rest-api {:doc "Run rest-api module tests"
                 :depends [-bootstrap]
                 :task (load-file "modules/rest-api/test/run_tests.clj")}

  test:claude-manager {:doc "Run claude-manager module tests"
                       :depends [-bootstrap]
                       :task (load-file "modules/claude-manager/test/run_tests.clj")}

  test:port-registry {:doc "Run port-registry module tests"
                      :depends [-bootstrap]
                      :task (load-file "modules/port-registry/test/run_tests.clj")}

  test:expert-registry {:doc "Run expert-registry module tests"
                        :depends [-bootstrap]
                        :task (load-file "modules/expert-registry/test/run_tests.clj")}

  test:ai-orchestrator {:doc "Run ai-orchestrator module tests"
                        :depends [-bootstrap]
                        :task (load-file "modules/ai-orchestrator/test/run_tests.clj")}

  test:ai-orchestrator-tools {:doc "Run ai-orchestrator-tools module tests"
                              :depends [-bootstrap]
                              :task (load-file "modules/ai-orchestrator-tools/test/run_tests.clj")}

  test:stdio {:doc "Run stdio transport tests"
              :depends [-bootstrap]
              :task (load-file "test/run_stdio_tests.clj")}

  test:nrepl-direct {:doc "Run nrepl-direct integration tests"
                     :depends [-bootstrap]
                     :task (load-file "test/run_nrepl_direct_tests.clj")}

  test:streamable {:doc "Run streamable-http module tests"
                   :depends [-bootstrap]
                   :task (load-file "modules/streamable-http/test/run_tests.clj")}

  test:message-bus {:doc "Run message-bus module tests"
                    :depends [-bootstrap]
                    :task (load-file "modules/message-bus/test/run_tests.clj")}

  test:datalevin-pod {:doc "Run datalevin-pod module tests"
                      :depends [-bootstrap]
                      :task (load-file "modules/datalevin-pod/test/run_tests.clj")}

  test:datalevin-mcp {:doc "Run datalevin-mcp module tests"
                      :depends [-bootstrap]
                      :task (load-file "modules/datalevin-mcp/test/run_tests.clj")}

  test:webserver {:doc "Run webserver module tests"
                  :depends [-bootstrap]
                  :task (load-file "modules/webserver/test/run_tests.clj")}

  test:sente-browser {:doc "Run sente-browser module tests"
                      :depends [-bootstrap]
                      :task (load-file "modules/sente-browser/test/run_tests.clj")}

  test:nrepl-proxy-server {:doc "Run nrepl-proxy-server module tests"
                           :depends [-bootstrap]
                           :task (load-file "modules/nrepl-proxy-server/test/run_tests.clj")}

  test:clojure-lsp {:doc "Run clojure-lsp module tests"
                    :depends [-bootstrap]
                    :task (load-file "modules/clojure-lsp/test/run_tests.clj")}

  test:atom-sync {:doc "Run atom-sync module tests"
                  :depends [-bootstrap]
                  :task (load-file "modules/atom-sync/test/run_tests.clj")}

  test:openai-http-provider {:doc "Run openai-http-provider module tests"
                             :depends [-bootstrap]
                             :task (load-file "modules/openai-http-provider/test/run_tests.clj")}

  test:anthropic-http-provider {:doc "Run anthropic-http-provider module tests"
                                :depends [-bootstrap]
                                :task (load-file "modules/anthropic-http-provider/test/run_tests.clj")}

  ;; Generic module test runner - runs tests for any module by name
  test:module {:doc "Run tests for a specific module (usage: bb test:module <module-name>)"
               :depends [-bootstrap]
               :task (let [module-name (first *command-line-args*)]
                       (if module-name
                         (let [test-file (str "modules/" module-name "/test/run_tests.clj")]
                           (if (.exists (java.io.File. test-file))
                             (load-file test-file)
                             (do (println "No test runner found:" test-file)
                                 (System/exit 1))))
                         (do (println "Usage: bb test:module <module-name>")
                             (println "Example: bb test:module atom-sync")
                             (System/exit 1))))}

  test:modules {:doc "Run all module tests"
                :task (do (run 'test:nrepl)
                          (run 'test:http-core)
                          (run 'test:mcp-http)
                          (run 'test:mcp-stdio)
                          (run 'test:rest-api)
                          (run 'test:port-registry)
                          (run 'test:expert-registry)
                          (run 'test:ai-orchestrator)
                          (run 'test:ai-orchestrator-tools)
                          (run 'test:message-bus)
                          (run 'test:datalevin-pod)
                          (run 'test:datalevin-mcp)
                          (run 'test:webserver)
                          (run 'test:sente-browser)
                          (run 'test:nrepl-proxy-server)
                          (run 'test:clojure-lsp)
                          (run 'test:atom-sync)
                          (run 'test:stdio)
                          (run 'test:streamable)
                          (run 'test:telemetry-db))}

  test:http {:doc "Run HTTP integration tests (server must be running)"
             :task (load-file "scripts/http_integration_test.clj")}

  test:streamable-http {:doc "Run Streamable HTTP integration test (server must be running on port)"
                        :task (apply shell "scripts/test_streamable_http.sh" *command-line-args*)}

  test:bootstrap {:doc "Run bootstrap configuration and CLI tests"
                 :task (load-file "test/run_bootstrap_tests.clj")}

  test:e2e {:doc "Run E2E MCP client tests (requires running server)"
            :task (load-file "test/e2e/run_tests.clj")}

  test:all {:doc "Run all tests (modules + bootstrap)"
            :task (do (run 'test:modules)
                      (run 'test:bootstrap))}

  mcp-eval {:doc "Evaluate Clojure code on a running MCP server"
            :task (load-file "scripts/mcp-eval-task.clj")}

  nrepl {:doc "nREPL CLI - connect, eval, load-file via MCP"
         :task (load-file "scripts/nrepl-task.clj")}

  nrepl-direct {:doc "Direct nREPL CLI - eval, load-file without MCP"
                :depends [-bootstrap]
                :task (load-file "scripts/nrepl_direct_cli.clj")}

  mcp {:doc "MCP CLI - init, tools, call via MCP"
       :task (load-file "scripts/mcp-task.clj")}

  clojure-lsp {:doc "Clojure LSP CLI - start, stop, definition, references, etc."
               :task (load-file "scripts/clojure_lsp_cli.clj")}

  pprint {:doc "Pretty-print EDN from stdin or file"
          :task (load-file "scripts/pprint.clj")}

  rebel-nrepl-client {:doc "Open iTerm2 with rebel-readline connected to nREPL [port]"
                      :task (load-file "scripts/rebel_nrepl_client.clj")}

  ;; ==========================================================================
  ;; Dev Environment Tasks
  ;; ==========================================================================

  dev:cb-v2 {:doc "Code Browser v2 dev env [start|stop|restart|status] (default: start)"
             :task (apply shell "bb" "scripts/cb_v2_dev.clj" *command-line-args*)}

  add-project {:doc "Add project directory to running Code Browser v2 <path> [-t target]"
               :task (apply shell "bb" "scripts/add_project_cli.clj" *command-line-args*)}

  ;; ==========================================================================
  ;; Statechart Tasks
  ;; ==========================================================================

  test:statecharts {:doc "Run statecharts validate tests"
                    :depends [-bootstrap]
                    :task (load-file "test/statecharts/run_tests.clj")}

  statechart:validate {:doc "Validate statechart machine [ns/var]"
                       :depends [-bootstrap]
                       :task (apply shell "bb" "scripts/statechart_validate.clj" *command-line-args*)}

  ;; ==========================================================================
  ;; Telemetry Tasks
  ;; ==========================================================================

  logs {:doc "Query telemetry logs from running server [-t target] [--level LEVEL] [--since TIME]"
        :task (apply shell "bb" "scripts/logs_cli.clj" *command-line-args*)}

  telemetry:catalog {:doc "Generate telemetry catalog [--report] [--level LVL] [--ns PREFIX] [--save] [--diff]"
                     :task (apply shell "bb" "scripts/telemetry_catalog.clj" *command-line-args*)}

  test:telemetry-db {:doc "Run telemetry-db module tests"
                     :depends [-bootstrap]
                     :task (load-file "modules/telemetry-db/test/run_tests.clj")}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                     {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}}}
