;; BB MCP Server System Configuration
;;
;; This file controls which modules are loaded at startup.
;; Only modules listed in :modules will be loaded - no auto-discovery.

{;; Base directory for modules (relative to project root)
 :modules-dir "modules"

 ;; Explicit list of modules to load (by name)
 ;; Only these modules will be loaded, in this order if no dependencies
 ;; Note: Modules can be internal (in modules/) or external (via BB_MCP_EXTERNAL_MODULES)
 ;; Note: "hello" is intentionally NOT in this list for dynamic load testing
 :modules ["echo" "strings" "calculate" "mcp-local-eval" "mcp-nrepl" "math"
           "datalevin-pod" "datalevin-mcp"
           "ai-orchestrator" "anthropic-http-provider" "openai-http-provider"
           "claude-subprocess-provider" "ai-orchestrator-tools"
           "directory-browser" "sente-browser" "nrepl-proxy-server"
           "clojure-lsp"]

 ;; Module-specific configuration (optional)
 ;; Keys match module names, values are passed to module's start function
 :config {"hello" {:greeting "Hi"}
          "nrepl-test-server" {:port 7888 :host "localhost"}
          "datalevin-pod" {:db-path "/var/db/datalevin/bb-mcp-server"}
          "sente-browser" {:enabled true :ws-port 8090 :bootstrap-port 8091 :code-browser true
                   ;; Phase 1.5E.3: Available projects for code browser
                   :projects ["/Users/franksiebenlist/Development/bb-mcp-server"
                              "/Users/franksiebenlist/Development/clj-ns-browser"
                              "/Users/franksiebenlist/Development/clojure-lsp"]}
          "nrepl-proxy-server" {:enabled true :port 1667 :write-port-file? true}}}
